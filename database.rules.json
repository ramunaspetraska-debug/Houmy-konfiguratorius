{
  /* HOUMY konfigūratoriaus duomenų bazės taisyklės.

     ADMINISTRATORIAI: sąrašas laikomas pačioje duomenų bazėje
     (houmy_admins/<el. paštas, kuriame taškai pakeisti kableliais>: true),
     NE kode — todėl el. paštai nematomi viešai. Sąrašą keičia tik projekto
     savininkas (Firebase konsolė / CLI), per internetą jo nei skaityti, nei
     keisti negalima. Visur žemiau „administratorius" reiškia:
       prisijungęs per Google, el. paštas patvirtintas ir yra houmy_admins sąraše.

     houmy_settings      — kainos ir tekstai: skaito visi, rašo administratoriai.
     houmy_proposals     — pasiūlymai/kliento variantai: galima tik SUKURTI;
                           perskaityti — tik žinant ID (nuoroda). Laisvą tekstą
                           (klientas, terminai, audinys) gali įrašyti tik administratorius.
     houmy_uzklausos     — klientų užklausos: galima tik SUKURTI (kartu su pasiūlymu);
                           skaito tik administratoriai.
     houmy_kainu_istorija, houmy_technologijos, houmy_kopijos — tik administratoriams. */
  "rules": {
    ".read": false,
    ".write": false,

    "houmy_admins": {
      "$k": {
        ".read": "auth != null && auth.token.email_verified == true && $k == auth.token.email.toLowerCase().replace('.', ',')"
      }
    },

    "houmy_settings": {
      ".read": true,
      ".write": "newData.exists() && auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      "prodTerm":       { ".validate": "newData.isString() && newData.val().length < 500" },
      "deliveryNote":   { ".validate": "newData.isString() && newData.val().length < 1000" },
      "additionalInfo": { ".validate": "newData.isString() && newData.val().length < 2000" },
      "appVersion":     { ".validate": "newData.isString() && newData.val().length < 100" },
      "updatedAt":      { ".validate": "newData.isNumber()" },
      "customPrices": {
        "$kaina": { ".validate": "newData.isNumber()" }
      },
      "$kita": { ".validate": false }
    },

    "houmy_uzklausos": {
      /* Klientų užklausos iš viešo konfigūratoriaus (houmy.lt). Skaityti gali tik
         administratoriai (admin skydelis „Užklausos"). Galima tik SUKURTI naują,
         ir tik su EGZISTUOJANČIU (tuo pačiu metu įrašomu) pasiūlymu.
         Laiško būsenos laukus įrašo serverio funkcija (ji taisyklių nepaiso). */
      ".read": "auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".indexOn": ["createdAt"],
      "$uid": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$uid.matches(/^-[A-Za-z0-9_-]{19}$/) && newData.hasChildren(['email', 'proposalId', 'createdAt'])",
        "email":      { ".validate": "newData.isString() && newData.val().length <= 100 && newData.val().matches(/^[^@\\s,;<>]+@[^@\\s,;<>]+[.][^@\\s,;<>]+$/)" },
        "name":       { ".validate": "newData.isString() && newData.val().length <= 150" },
        "phone":      { ".validate": "newData.isString() && newData.val().length <= 30" },
        "comment":    { ".validate": "newData.isString() && newData.val().length <= 1500" },
        "collection": { ".validate": "newData.isString() && newData.val().length < 50" },
        "total":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
        "proposalId": { ".validate": "newData.isString() && newData.val().matches(/^-[A-Za-z0-9_-]{19}$/) && newData.parent().parent().parent().child('houmy_proposals').child(newData.val()).exists()" },
        "kopija":     { ".validate": "newData.isBoolean()" },
        "createdAt":  { ".validate": "newData.isNumber() && newData.val() == now" },
        "version":    { ".validate": "newData.isString() && newData.val().length < 100" },
        "$kita":      { ".validate": false }
      }
    },

    "houmy_proposals": {
      ".read": false,
      ".indexOn": ["createdAt"],
      "$pid": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$pid.matches(/^-[A-Za-z0-9_-]{19}$/) && newData.hasChildren(['modules', 'breakdown', 'total', 'finalTotal', 'createdAt'])",
        "modules": {
          ".validate": "newData.hasChildren()",
          "$m": {
            ".validate": "$m.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['id', 'c'])",
            "id":  { ".validate": "newData.isString() && newData.val().length < 40" },
            "n":   { ".validate": "newData.isString() && newData.val().length < 60 && !newData.val().contains('<') && !newData.val().contains('>')" },
            "c":   { ".validate": "newData.isString() && newData.val().length < 20" },
            "p":   { ".validate": "(newData.isString() && newData.val().length < 12) || newData.isNumber()" },
            "w":   { ".validate": "(newData.isString() && newData.val().length < 12) || newData.isNumber()" },
            "h":   { ".validate": "(newData.isString() && newData.val().length < 12) || newData.isNumber()" },
            "a":   { ".validate": "(newData.isString() && newData.val().length < 12) || newData.isNumber()" },
            "z":   { ".validate": "(newData.isString() && newData.val().length < 12) || newData.isNumber()" },
            "l":   { ".validate": "newData.isNumber()" },
            "t":   { ".validate": "newData.isNumber()" },
            "exp": { ".validate": "(newData.isString() && newData.val().length < 6) || newData.isBoolean()" },
            "j":   { ".validate": "newData.isString() && newData.val().length < 3" },
            "$kita": { ".validate": false }
          }
        },
        "breakdown": {
          ".validate": "newData.hasChildren()",
          "$b": {
            ".validate": "$b.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['name', 'qty', 'unit'])",
            "name": { ".validate": "newData.isString() && newData.val().length < 100 && !newData.val().contains('<') && !newData.val().contains('>')" },
            "qty":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000" },
            "unit": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
            "$kita": { ".validate": false }
          }
        },
        "total":          { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
        "finalTotal":     { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
        "discountVal":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "manualPriceVal": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000000" },
        "fabricGroup":    { ".validate": "newData.isString() && newData.val().length < 10" },
        "fabricColor":    { ".validate": "newData.isString() && newData.val().length < 30" },
        /* Laisvas tekstas — TIK administratoriaus pasiūlymuose (kitaip bet kas galėtų
           sukurti „HOUMY" puslapį su savo tekstu, pvz. netikrais mokėjimo rekvizitais) */
        "fabricName":     { ".validate": "newData.isString() && newData.val().length < 300 && newData.parent().child('admin').val() == true" },
        "term":           { ".validate": "newData.isString() && newData.val().length < 500 && newData.parent().child('admin').val() == true" },
        "delivery":       { ".validate": "newData.isString() && newData.val().length < 1000 && newData.parent().child('admin').val() == true" },
        "additionalInfo": { ".validate": "newData.isString() && newData.val().length < 2000 && newData.parent().child('admin').val() == true" },
        "kambarys": {
          ".validate": "newData.hasChildren(['w', 'h'])",
          "w": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 5000" },
          "h": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 5000" },
          "x": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
          "y": { ".validate": "newData.isNumber() && newData.val() > -100000 && newData.val() < 100000" },
          "$kita": { ".validate": false }
        },
        "client": {
          ".validate": "newData.hasChildren() && newData.parent().child('admin').val() == true",
          "name":     { ".validate": "newData.isString() && newData.val().length < 300" },
          "address":  { ".validate": "newData.isString() && newData.val().length < 500" },
          "project":  { ".validate": "newData.isString() && newData.val().length < 300" },
          "designer": { ".validate": "newData.isString() && newData.val().length < 300" },
          "$kita":    { ".validate": false }
        },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() == now" },
        "version":   { ".validate": "newData.isString() && newData.val().length < 100" },
        /* admin == true: pasiūlymą sukūrė administratorius — tik toks rodomas
           kaip „Komercinis pasiūlymas" ir tik jame leidžiamas laisvas tekstas */
        "admin":     { ".validate": "newData.isBoolean() && newData.val() == true && auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true" },
        "$kita":     { ".validate": false }
      }
    },

    "houmy_kainu_istorija": {
      /* Kainų keitimo istorija (admin skydelis). Įrašus galima tik PRIDĖTI;
         laukas „kas" turi sutapti su prisijungusio administratoriaus el. paštu. */
      ".read": "auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".indexOn": ["laikas"],
      "$id": {
        ".write": "!data.exists() && newData.exists() && auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
        ".validate": "newData.hasChildren(['laikas', 'raktas', 'kas'])",
        "laikas": { ".validate": "newData.isNumber() && newData.val() == now" },
        "data":   { ".validate": "newData.isString() && newData.val().length < 30" },
        "raktas": { ".validate": "newData.isString() && newData.val().length < 80" },
        "buvo":   { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length < 30)" },
        "tapo":   { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length < 30)" },
        "kas":    { ".validate": "newData.isString() && newData.val() == auth.token.email" },
        "$kita":  { ".validate": false }
      }
    },

    "houmy_technologijos": {
      /* Mėnesinės technologijų patikros ataskaita (admin skydelis „🔧 Technologijos").
         Rašo TIK serverio funkcija technologijuPatikra. */
      ".read": "auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".write": false
    },

    "houmy_kopijos": {
      /* Automatinės kainų ir nustatymų atsarginės kopijos (kasdien, jei kas pasikeitė;
         saugomos 90 naujausių). Rašo TIK serverio funkcija senuUzklausuValymas. */
      ".read": "auth != null && auth.token.email_verified == true && root.child('houmy_admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() == true",
      ".write": false
    }
  }
}
